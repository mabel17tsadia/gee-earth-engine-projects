// ============================================================================
// STEP 2: IMPROVED CLOUD MASKING
// ============================================================================

// Function to join Sentinel-2 SR with Cloud Probability
function getS2WithCloudMask(geometry, startDate, endDate) {
  var s2_sr = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED');
  var s2_clouds = ee.ImageCollection('COPERNICUS/S2_CLOUD_PROBABILITY');
  
  // Join the two collections
  var s2 = ee.ImageCollection(ee.Join.saveFirst('cloud_mask').apply({
    primary: s2_sr.filterBounds(geometry)
                  .filterDate(startDate, endDate),
    secondary: s2_clouds,
    condition: ee.Filter.equals({
      leftField: 'system:index', 
      rightField: 'system:index'
    })
  }));
  
  return s2;
}

// Improved cloud masking function using Cloud Probability
function maskS2clouds_prob(img) {
  // Get the cloud probability layer
  var cloudProb = ee.Image(img.get('cloud_mask')).select('probability');
  
  // Create cloud mask (probability < 40%)
  var isNotCloud = cloudProb.lt(40);
  
  // Also mask very dark and very bright pixels
  var darkPixels = img.select('B8').gt(100);
  var brightPixels = img.select('B8').lt(10000);
  
  // Combine all masks
  var finalMask = isNotCloud.and(darkPixels).and(brightPixels);
  
  // Apply mask and scale to reflectance
  return img.updateMask(finalMask)
      .divide(10000)
      .copyProperties(img, ['system:time_start']);
}

// ============================================================================
// STEP 3: VEGETATION INDICES CALCULATION
// ============================================================================

function addVegetationIndices(image) {
  
  // GCVI - Green Chlorophyll Vegetation Index (PRIMARY)
  var GCVI = image.select('B8').divide(image.select('B3')).subtract(1)
      .rename('GCVI');
  
  // NDVI - Normalized Difference Vegetation Index
  var NDVI = image.normalizedDifference(['B8', 'B4']).rename('NDVI');
  
  // Red-edge NDVI variants
  var RDNDVI1 = image.normalizedDifference(['B8', 'B5']).rename('RDNDVI1');
  var RDNDVI2 = image.normalizedDifference(['B8', 'B6']).rename('RDNDVI2');
  
  // Red-edge GCVI variants
  var RDGCVI1 = image.select('B8').divide(image.select('B5')).subtract(1)
      .rename('RDGCVI1');
  var RDGCVI2 = image.select('B8').divide(image.select('B6')).subtract(1)
      .rename('RDGCVI2');
  
  // SWIR-based indices
  var NBR1 = image.normalizedDifference(['B8', 'B11']).rename('NBR1');
  var NBR2 = image.normalizedDifference(['B8', 'B12']).rename('NBR2');
  var NDTI = image.normalizedDifference(['B11', 'B12']).rename('NDTI');
  
  // Soil-adjusted indices
  var CRC = image.normalizedDifference(['B11', 'B3']).rename('CRC');
  var STI = image.select('B11').divide(image.select('B12')).rename('STI');
  
  // MERIS Terrestrial Chlorophyll Index
  var MTCI = image.select('B8').subtract(image.select('B5'))
      .divide(image.select('B5').subtract(image.select('B4')))
      .rename('MTCI');
  
  return image.addBands([
    GCVI, NDVI, RDNDVI1, RDNDVI2, RDGCVI1, RDGCVI2,
    NBR1, NBR2, NDTI, CRC, STI, MTCI
  ]);
}

// ============================================================================
// STEP 4: SENTINEL-1 SAR PROCESSING
// ============================================================================

// Refined Lee Speckle Filter
function refinedLee(image) {
  var bandNames = image.bandNames();
  
  var weights = ee.List.repeat(ee.List.repeat(1, 7), 7);
  var kernel = ee.Kernel.fixed(7, 7, weights, 3, 3, false);
  
  var mean = image.reduceNeighborhood(ee.Reducer.mean(), kernel);
  var variance = image.reduceNeighborhood(ee.Reducer.variance(), kernel);
  
  var meanSquared = mean.multiply(mean);
  var kappa = variance.divide(meanSquared.add(0.0001));
  var weights = variance.divide(variance.add(meanSquared.multiply(kappa)));
  
  var filtered = mean.add(image.subtract(mean).multiply(weights));
  
  return filtered.rename(bandNames);
}

function processS1(image) {
  var filtered = refinedLee(image);
  
  var VV = filtered.select('VV').rename('VV_filtered');
  var VH = filtered.select('VH').rename('VH_filtered');
  var RATIO = VH.divide(VV.add(0.0001)).rename('VH_VV_RATIO');
  var DIFF = VV.subtract(VH).rename('VV_VH_DIFF');
  
  return image.addBands([VV, VH, RATIO, DIFF]);
}

// ============================================================================
// STEP 5: SEASONAL COMPOSITE GENERATION
// ============================================================================

function createSeasonalComposites(collection, startDate, endDate) {
  
  var season1Start = ee.Date(startDate);
  var season1End = season1Start.advance(30, 'day');
  
  var season2Start = season1End;
  var season2End = season2Start.advance(60, 'day');
  
  var season3Start = season2End;
  var season3End = ee.Date(endDate);
  
  var s1 = collection.filterDate(season1Start, season1End)
      .median()
      .select(['GCVI', 'NDVI', 'RDNDVI1', 'RDGCVI1', 'NBR1', 'NDTI', 'STI'])
      .rename(['GCVI_S1', 'NDVI_S1', 'RDNDVI1_S1', 'RDGCVI1_S1', 
               'NBR1_S1', 'NDTI_S1', 'STI_S1']);
  
  var s2 = collection.filterDate(season2Start, season2End)
      .median()
      .select(['GCVI', 'NDVI', 'RDNDVI1', 'RDGCVI1', 'NBR1', 'NDTI', 'STI'])
      .rename(['GCVI_S2', 'NDVI_S2', 'RDNDVI1_S2', 'RDGCVI1_S2', 
               'NBR1_S2', 'NDTI_S2', 'STI_S2']);
  
  var s3 = collection.filterDate(season3Start, season3End)
      .median()
      .select(['GCVI', 'NDVI', 'RDNDVI1', 'RDGCVI1', 'NBR1', 'NDTI', 'STI'])
      .rename(['GCVI_S3', 'NDVI_S3', 'RDNDVI1_S3', 'RDGCVI1_S3', 
               'NBR1_S3', 'NDTI_S3', 'STI_S3']);
  
  return s1.addBands(s2).addBands(s3);
}

// ============================================================================
// STEP 6: PEAK VI EXTRACTION
// ============================================================================

function extractPeakVI(collection, bands) {
  var maxValues = collection.select(bands).max();
  var meanValues = collection.select(bands).mean();
  var stdValues = collection.select(bands).reduce(ee.Reducer.stdDev());
  
  var peakBands = bands.map(function(name) {
    return ee.String('peak_').cat(name);
  });
  
  var meanBands = bands.map(function(name) {
    return ee.String('mean_').cat(name);
  });
  
  var stdBands = bands.map(function(name) {
    return ee.String('std_').cat(name);
  });
  
  maxValues = maxValues.rename(peakBands);
  meanValues = meanValues.rename(meanBands);
  stdValues = stdValues.rename(stdBands);
  
  return maxValues.addBands(meanValues).addBands(stdValues);
}

// ============================================================================
// STEP 7: WEATHER DATA EXTRACTION
// ============================================================================

function extractRainfall(geometry, startDate, endDate) {
  var chirps = ee.ImageCollection('UCSB-CHG/CHIRPS/DAILY')
      .filterDate(startDate, endDate)
      .filterBounds(geometry);
  
  var totalRainfall = chirps.sum().rename('total_rainfall_mm');
  var meanRainfall = chirps.mean().rename('mean_daily_rainfall');
  var maxRainfall = chirps.max().rename('max_daily_rainfall');
  var stdRainfall = chirps.reduce(ee.Reducer.stdDev())
      .rename('std_daily_rainfall');
  
  var rainyDays = chirps.map(function(img) {
    return img.gt(1);
  }).sum().rename('rainy_days');
  
  return totalRainfall.addBands([meanRainfall, maxRainfall, stdRainfall, rainyDays]);
}

function extractTemperature(geometry, startDate, endDate) {
  var modisLST = ee.ImageCollection('MODIS/061/MYD11A2')
      .filterDate(startDate, endDate)
      .filterBounds(geometry)
      .select(['LST_Day_1km', 'LST_Night_1km']);
  
  var lstCelsius = modisLST.map(function(img) {
    return img.multiply(0.02).subtract(273.15)
        .copyProperties(img, ['system:time_start']);
  });
  
  var meanDayTemp = lstCelsius.select('LST_Day_1km').mean()
      .rename('mean_day_temp_C');
  var meanNightTemp = lstCelsius.select('LST_Night_1km').mean()
      .rename('mean_night_temp_C');
  var maxDayTemp = lstCelsius.select('LST_Day_1km').max()
      .rename('max_day_temp_C');
  var minDayTemp = lstCelsius.select('LST_Day_1km').min()
      .rename('min_day_temp_C');
  
  return meanDayTemp.addBands([meanNightTemp, maxDayTemp, minDayTemp]);
}

// ============================================================================
// STEP 8: SOIL DATA EXTRACTION
// ============================================================================

function extractSoilProperties() {
  
  var organicCarbon = ee.Image("OpenLandMap/SOL/SOL_ORGANIC-CARBON_USDA-6A1C_M/v02")
      .select('b0').rename('soil_OC_g_kg');
  
  var nitrogen = organicCarbon.multiply(0.1).rename('soil_N_g_kg');
  
  var pH = ee.Image("OpenLandMap/SOL/SOL_PH-H2O_USDA-4C1A2A_M/v02")
      .select('b0').multiply(0.1).rename('soil_pH');
  
  var clay = ee.Image("OpenLandMap/SOL/SOL_CLAY-WFRACTION_USDA-3A1A1A_M/v02")
      .select('b0').rename('soil_clay_percent');
  
  var sand = ee.Image("OpenLandMap/SOL/SOL_SAND-WFRACTION_USDA-3A1A1A_M/v02")
      .select('b0').rename('soil_sand_percent');
  
  var bulkDensity = ee.Image("OpenLandMap/SOL/SOL_BULKDENS-FINEEARTH_USDA-4A1H_M/v02")
      .select('b0').multiply(0.01).rename('soil_bulk_density_kg_m3');
  
  var waterContent = ee.Image("OpenLandMap/SOL/SOL_WATERCONTENT-33KPA_USDA-4B1C_M/v01")
      .select('b0').rename('soil_water_content');
  
  return organicCarbon.addBands([nitrogen, pH, clay, sand, bulkDensity, waterContent]);
}

// ============================================================================
// STEP 9: FEATURE EXTRACTION PER FARM (COMPLETELY FIXED)
// ============================================================================

function extractFarmFeatures(farm) {
  
  var farmId = farm.get('farm_id');
  var year = ee.Number(farm.get('year'));
  var geometry = farm.geometry();
  var area = farm.get('area_ha');
  var actualYield = farm.get('yield_mt_h');
  
  // Build date strings SERVER-SIDE
  var yearString = ee.Algorithms.String(year);
  var startDate = yearString.cat(seasonStart);
  var endDate = yearString.cat(seasonEnd);
  
  // SENTINEL-2 PROCESSING
  var s2_with_clouds = getS2WithCloudMask(geometry, startDate, endDate);
  var s2 = s2_with_clouds.map(maskS2clouds_prob).map(addVegetationIndices);
  var s2Count = s2.size();
  
  // Create seasonal composites
  var seasonalComposite = createSeasonalComposites(s2, startDate, endDate);
  
  // Extract peak VI values
  var peakVI = extractPeakVI(s2, ['GCVI', 'NDVI', 'RDNDVI1', 'RDGCVI1']);
  
  // Combine features
  var opticalFeatures = seasonalComposite.addBands(peakVI);
  
  // SENTINEL-1 SAR PROCESSING
  var s1 = ee.ImageCollection('COPERNICUS/S1_GRD')
      .filterBounds(geometry)
      .filterDate(startDate, endDate)
      .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VV'))
      .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VH'))
      .filter(ee.Filter.eq('instrumentMode', 'IW'))
      .map(processS1);
  
  var s1Count = s1.size();
  var sarFeatures = s1.select(['VV_filtered', 'VH_filtered', 'VH_VV_RATIO', 'VV_VH_DIFF']).median();
  
  // WEATHER DATA
  var rainfall = extractRainfall(geometry, startDate, endDate);
  var temperature = extractTemperature(geometry, startDate, endDate);
  
  // SOIL DATA
  var soil = extractSoilProperties();
  
  // COMBINE ALL FEATURES
  var allFeatures = opticalFeatures
      .addBands(sarFeatures)
      .addBands(rainfall)
      .addBands(temperature)
      .addBands(soil);
  
  // Reduce to mean values within farm boundary
  var stats = allFeatures.reduceRegion({
    reducer: ee.Reducer.mean(),
    geometry: geometry,
    scale: 10,
    maxPixels: 1e9,
    bestEffort: true,
    tileScale: 4
  });
  
  // Return feature with all properties
  return ee.Feature(null, stats)
      .set('farm_id', farmId)
      .set('year', year)
      .set('area_ha', area)
      .set('actual_yield_mt_ha', actualYield)
      .set('num_s2_images', s2Count)
      .set('num_s1_images', s1Count)
      .setGeometry(geometry);
}

