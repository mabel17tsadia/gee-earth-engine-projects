// Center the map on the AOI
Map.centerObject(aoi, 8);

// Function to mask clouds using the QA_PIXEL band for Landsat 5 and 7
function maskClouds(image) {
  var qa = image.select('QA_PIXEL');
  var cloudBit = 1 << 3; // Bit 3: Cloud
  var cloudShadowBit = 1 << 5; // Bit 5: Cloud shadow
  var mask = qa.bitwiseAnd(cloudBit).eq(0)
              .and(qa.bitwiseAnd(cloudShadowBit).eq(0));
  return image.updateMask(mask);
}

// Function to create a cloud-free composite for a given year and Landsat collection
function createComposite(year, collection, bands, visParams, cloudCoverThreshold, dateRangeExtension) {
  var startDate = ee.Date.fromYMD(year - dateRangeExtension, 1, 1);
  var endDate = ee.Date.fromYMD(year + dateRangeExtension, 12, 31);
  
  var filtered = collection
    .filterDate(startDate, endDate)
    .filterBounds(aoi)
    .filter(ee.Filter.lt('CLOUD_COVER', cloudCoverThreshold));
  
  // Print debugging info
  print('Filtered images for ' + year + ':', filtered.size());
  print('Image metadata for ' + year + ':', filtered);
  
  // Check if the collection is empty
  var composite = ee.Image(ee.Algorithms.If(
    filtered.size().gt(0),
    filtered.map(maskClouds).median().select(bands),
    ee.Image().select() // Return empty image if no data
  ));
  
  return composite;
}

// Load Landsat collections
var landsat5 = ee.ImageCollection('LANDSAT/LT05/C02/T1_L2'); // Landsat 5 TM for 1984, 1993
var landsat7 = ee.ImageCollection('LANDSAT/LE07/C02/T1_L2'); // Landsat 7 ETM+ for 2003

// Define visualization parameters for true-color (RGB)
var visParamsL5 = {
  bands: ['SR_B3', 'SR_B2', 'SR_B1'],
  min: 8000,
  max: 18000,
  gamma: 1.4
};
var visParamsL7 = {
  bands: ['SR_B3', 'SR_B2', 'SR_B1'],
  min: 8000,
  max: 18000,
  gamma: 1.4
};

// Create composites for each year, clipped to the AOI
var composite1985 = createComposite(1985, landsat5, ['SR_B3', 'SR_B2', 'SR_B1'], visParamsL5, 70, 1).clip(aoi); // 1984 instead of 1983
var composite1993 = createComposite(1996, landsat5, ['SR_B3', 'SR_B2', 'SR_B1'], visParamsL5, 70, 2).clip(aoi); // Extended range for 1993
var composite2003 = createComposite(2003, landsat7, ['SR_B3', 'SR_B2', 'SR_B1'], visParamsL7, 50, 1).clip(aoi); // Unchanged for 2003

// Add layers to the map (hide 1984 and 1993 by default to avoid errors if empty)
Map.addLayer(aoi, {color: 'red'}, 'AOI Boundary', false);
Map.addLayer(composite1985, visParamsL5, '1985 Landsat 5', false);
Map.addLayer(composite1993, visParamsL5, '1996 Landsat 5', false);
Map.addLayer(composite2003, visParamsL7, '2003 Landsat 7', true);

// Print image info for verification
print('AOI:', aoi);
print('1985 Composite:', composite1985);
print('1996 Composite:', composite1993);
print('2003 Composite:', composite2003);

