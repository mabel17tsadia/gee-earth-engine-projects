// Give mined label = 1
var minedSamples = minedPolygons.map(function(f){ return f.set('class', 1); });

// Define AOI (same one from step 1)
var AOI = aoi;  // reuse from your existing script

// Buffer mined areas to exclude near zones for non-mined sampling
var minedBuffer = minedSamples.geometry().buffer(200);

// Generate random non-mined points outside mined zones
var nonMinedSamples = ee.FeatureCollection.randomPoints({
  region: AOI.geometry().difference(minedBuffer),
  points: 100, // adjust number based on your AOI size
  seed: 123
}).map(function(f){ return f.set('class', 0); });

// Merge mined + non-mined
var labeledSamples = minedSamples.merge(nonMinedSamples);
print('Total labeled samples:', labeledSamples.size());

Map.addLayer(minedSamples, {color: 'red'}, 'Mined Samples');
Map.addLayer(nonMinedSamples, {color: 'green'}, 'Non-Mined Samples');



// // =====================================================
// // STEP 3B/3C — Extract 2025 Composite/ Add Indices to 2025 Composite
// // =====================================================
var composite2025 = ee.Image(composites[2025]);
var composite2025_with_indices = ee.Image(composites_with_indices[2025]);



// =====================================================
// STEP 3D — Sample for Classifier
// =====================================================

var bands = ['B2_p20','B3_p20','B4_p20','B5_p20','B6_p20','B7_p20','NDVI','NDWI','NDBI','GPI'];

var training = composite2025_with_indices.select(bands).sampleRegions({
  collection: labeledSamples,
  properties: ['class'],
  scale: 30
});

print('Training samples:', training.size());



// =====================================================
// STEP 3E — Train/Test Split
// =====================================================
var withRandom = training.randomColumn('random', 42);
var trainSet = withRandom.filter(ee.Filter.lt('random', 0.7));
var testSet  = withRandom.filter(ee.Filter.gte('random', 0.7));

print('Train set size:', trainSet.size());
print('Test set size:', testSet.size());



// =====================================================
// STEP 3F — Train Random Forest Classifier
// =====================================================
var rf = ee.Classifier.smileRandomForest({
  numberOfTrees: 100,
  variablesPerSplit: null,
  minLeafPopulation: 1
}).setOutputMode('CLASSIFICATION');

var trainedRF = rf.train({
  features: trainSet,
  classProperty: 'class',
  inputProperties: bands
});

print('✅ Random Forest training completed!');



// =====================================================
// STEP 3G — Model Evaluation
// =====================================================
var validated = testSet.classify(trainedRF);
var cm = validated.errorMatrix('class', 'classification');

print('=== CONFUSION MATRIX ===');
print(cm);
print('Accuracy:', cm.accuracy());
print('Kappa:', cm.kappa());



// =====================================================
