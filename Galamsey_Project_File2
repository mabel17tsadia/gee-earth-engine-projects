// ---------------------------
// Define index functions
// ---------------------------
function addIndices(img) {
  var ndvi = img.normalizedDifference(['B5_p20', 'B4_p20']).rename('NDVI');
  var ndbi = img.normalizedDifference(['B6_p20', 'B5_p20']).rename('NDBI');
  var ndmi = img.normalizedDifference(['B5_p20', 'B6_p20']).rename('NDMI');
  var gci  = img.expression('(B5_p20 / B3_p20) - 1', {
    'B5_p20': img.select('B5_p20'),
    'B3_p20': img.select('B3_p20')
  }).rename('GCI');
  var gpi  = img.expression('(B6_p20 * B5_p20) / (B4_p20 + B2_p20)', {
    'B6_p20': img.select('B6_p20'),
    'B5_p20': img.select('B5_p20'),
    'B4_p20': img.select('B4_p20'),
    'B2_p20': img.select('B2_p20')
  }).rename('GPI');
  // Gold Hotspots (commented out due to tile errors)
  // var gold = img.expression('(B7_p20 / B5_p20)', {
  //   'B7_p20': img.select('B7_p20'),
  //   'B5_p20': img.select('B5_p20')
  // }).rename('GoldHotspots');

  return img.addBands([ndvi, ndbi, ndmi, gci, gpi]);
}

