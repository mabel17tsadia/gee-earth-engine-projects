var folderName = 'Galamsey_Project_BDG';      // Drive folder
var startYear = 2010;
var endYear   = 2025;

// ---------------------------
// LOAD LANDSAT 8 SR COLLECTION
// ---------------------------
var l8 = ee.ImageCollection('LANDSAT/LC08/C02/T1_L2');

// ---------------------------
// CLOUD MASK FUNCTION USING QA_PIXEL
// ---------------------------
function maskL8sr(image) {
  var qaPixel = image.select('QA_PIXEL');
  var cloudShadowBitMask = (1 << 3);
  var cloudBitMask = (1 << 5);
  var mask = qaPixel.bitwiseAnd(cloudShadowBitMask).eq(0)
              .and(qaPixel.bitwiseAnd(cloudBitMask).eq(0))

  return image.updateMask(mask)
              .multiply(0.0000275)
              .add(-0.2)
              .select(
                ['SR_B2','SR_B3','SR_B4','SR_B5','SR_B6','SR_B7'],
                ['B2','B3','B4','B5','B6','B7']
              );
}

// ---------------------------
// LOOP THROUGH YEARS
// ---------------------------
for (var year = startYear; year <= endYear; year++) {

  // var start = ee.Date.fromYMD(year, 1, 1);
  // var end   = ee.Date.fromYMD(year, 12, 31);
var start = ee.Date.fromYMD(year - 1, 1, 1);
var end = ee.Date.fromYMD(year + 1, 12, 31);

  // Filter, mask clouds, and make median composite
  var l8_filtered = l8.filterBounds(aoi)
                      .filterDate(start, end)
                       //.filter(ee.Filter.lt('CLOUD_COVER', 10))
                      .map(maskL8sr);

  // var composite = l8_filtered.median().clip(aoi);
  //var composite = l8_filtered.reduce(ee.Reducer.percentile([20])).clip(aoi);
 
  // Median or percentile composite
var composite = l8_filtered.reduce(ee.Reducer.percentile([20])).clip(aoi);

// Fill small gaps using focal mean smoothing
var filled = composite.focal_mean({
  radius: 90,          // smooth 90m neighborhood
  units: 'meters',
  kernelType: 'circle'
}).blend(composite);    // blend with original to keep detail


  // Add to Map
  // Map.addLayer(composite, {bands:['B4','B3','B2'], min:0, max:0.3},
  //             year + ' Landsat8 Composite');
  Map.addLayer(filled, {bands:['B4_p20','B3_p20','B2_p20'], min:0, max:0.3},
              year + ' Landsat8 Composite');

  // ---------------------------
  // EXPORT TO GOOGLE DRIVE
  // ---------------------------
  Export.image.toDrive({
    image: composite,
    description: 'L8_' + year + '_Composite',
    folder: folderName,
    fileNamePrefix: 'L8_' + year + '_Composite',
    region: aoi,
    scale: 30,                 // Landsat native resolution
    crs: 'EPSG:32630',         // UTM Zone 30N (fits Western Ghana)
    maxPixels: 1e13
  });
 }



