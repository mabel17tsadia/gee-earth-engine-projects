  [ legends ],
  // layout
  ui.Panel.Layout.flow('vertical'),
  // style
  {
    position: 'bottom-left',
    width: '180px',
    height: '250px',         // fixed height -> scrollbar appears when needed
    padding: '4px',
    backgroundColor: 'rgba(255,255,255,0.8)'
  }
);

Map.add(scrollPanel);
