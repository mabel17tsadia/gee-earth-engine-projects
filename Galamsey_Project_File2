  var start = ee.Date.fromYMD(year - 1, 1, 1);
  var end = ee.Date.fromYMD(year + 1, 12, 31);

  var l8_filtered = l8.filterBounds(aoi)
                      .filterDate(start, end)
                      .map(maskL8sr);

  print('Year ' + year + ' image count:', l8_filtered.size());
  if (l8_filtered.size().getInfo() === 0) continue;

  var composite = l8_filtered.reduce(ee.Reducer.percentile([20])).clip(aoi);
  var filled = composite.focal_mean({
    radius: 90, units: 'meters', kernelType: 'circle'
  }).blend(composite);

  // Export composite
  Export.image.toDrive({
    image: composite,
    description: 'L8_' + year + '_Composite',
    folder: folderName,
    fileNamePrefix: 'L8_' + year + '_Composite',
    region: aoi,
    scale: 30,
    crs: 'EPSG:32630',
    maxPixels: 1e13
  });

  // Add indices
  var indices = addIndices(filled);

  // Export indices
  Export.image.toDrive({
    image: indices,
    description: 'L8_' + year + '_Composite_Indices',
    folder: folderName,
    fileNamePrefix: 'L8_' + year + '_Composite_Indices',
    region: aoi,
    scale: 30,
    crs: 'EPSG:32630',
    maxPixels: 1e13
  });

  // ---------------------------------------------
  // SHOW ONLY 2025 LAYERS ON MAP
