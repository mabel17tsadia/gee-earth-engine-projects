  // ---------------------------------------------
  if (year === visualYear) {
    Map.addLayer(filled, {bands:['B4_p20','B3_p20','B2_p20'], min:0, max:0.3},
                year + ' Composite', false);

    Object.keys(vis).forEach(function(key) {
      Map.addLayer(indices.select(key), vis[key], year + ' ' + key, false);
    });
  }

