// ---------------------------
// CLOUD MASK FUNCTION USING QA_PIXEL
// ---------------------------
function maskL8sr(image) {
  var qaPixel = image.select('QA_PIXEL');
  var cloudShadowBitMask = (1 << 3);
  var cloudBitMask = (1 << 5);
  var mask = qaPixel.bitwiseAnd(cloudShadowBitMask).eq(0)
              .and(qaPixel.bitwiseAnd(cloudBitMask).eq(0));

  return image.updateMask(mask)
              .multiply(0.0000275)
              .add(-0.2)
              .select(
                ['SR_B2','SR_B3','SR_B4','SR_B5','SR_B6','SR_B7'],
                ['B2','B3','B4','B5','B6','B7']
              );
}



// ---------------------------
// SPECTRAL INDICES FUNCTION
// ---------------------------
function addIndices(image) {
  var ndvi = image.normalizedDifference(['B5_p20', 'B4_p20']).rename('NDVI');
  var evi = image.expression(
    '2.5 * ((NIR - RED) / (NIR + 6*RED - 7.5*BLUE + 1))', {
      'NIR': image.select('B5_p20'),
      'RED': image.select('B4_p20'),
      'BLUE': image.select('B2_p20')
    }).rename('EVI');
  var ndwi = image.normalizedDifference(['B3_p20','B5_p20']).rename('NDWI');
  var mndwi = image.normalizedDifference(['B3_p20','B6_p20']).rename('MNDWI');
  var ndbi = image.normalizedDifference(['B6_p20','B5_p20']).rename('NDBI');
  var nbr = image.normalizedDifference(['B5_p20','B7_p20']).rename('NBR');
  var bsi = image.expression(
    '((SWIR1 + RED) - (NIR + BLUE)) / ((SWIR1 + RED) + (NIR + BLUE))', {
      'SWIR1': image.select('B6_p20'),
      'RED': image.select('B4_p20'),
      'NIR': image.select('B5_p20'),
      'BLUE': image.select('B2_p20')
    }).rename('BSI');
  var ioi = image.select('B4_p20').divide(image.select('B2_p20')).rename('IOI');
  var cmr = image.select('B6_p20').divide(image.select('B7_p20')).rename('CMR');
  var gpi = image.expression(
    '((RED/BLUE) + (SWIR1/SWIR2)) / (GREEN + NIR)', {
      'RED': image.select('B4_p20'),
      'BLUE': image.select('B2_p20'),
      'SWIR1': image.select('B6_p20'),
      'SWIR2': image.select('B7_p20'),
      'GREEN': image.select('B3_p20'),
      'NIR': image.select('B5_p20')
    }).rename('GPI');

  return image.addBands([ndvi, evi, ndwi, mndwi, ndbi, nbr, bsi, ioi, cmr, gpi]);
}

