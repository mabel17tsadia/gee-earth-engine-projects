function printBandNames(col, name) {
  var count = col.size();
  // Get the first image safely
  var firstImg = ee.Image(col.first());
  
  // Only print band names if there are images
  var bands = ee.Algorithms.If(
    count.gt(0),
    firstImg.bandNames(),
    'No images found'
  );
  
  print(name + ':', bands);
}

