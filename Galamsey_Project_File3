//................
////Build NDVI time series (monthly) per pixel
//..........................

// ---------------------------
// FUNCTION: Compute MONTHLY NDVI
// ---------------------------
function addNDVI(image) {
  return image.addBands(
    image.normalizedDifference(['NIR', 'Red']).rename('NDVI')
  );
}

// ---------------------------
// PARAMETERS
// ---------------------------
var startYear = 2010;
var endYear = 2025;
var months = ee.List.sequence(1, 12);

// Initialize empty ImageCollection
var monthlyNDVIcol = ee.ImageCollection([]);

// ---------------------------
// LOOP: Year and Month
// ---------------------------
for (var y = startYear; y <= endYear; y++) {
  months.getInfo().forEach(function(m) {
    var start = ee.Date.fromYMD(y, m, 1);
    var end = start.advance(1, 'month');

    // Merge Landsat collections for this month
    var collection = ee.ImageCollection('LANDSAT/LT05/C02/T1_L2')
      .merge(ee.ImageCollection('LANDSAT/LE07/C02/T1_L2'))
      .merge(ee.ImageCollection('LANDSAT/LC08/C02/T1_L2'))
      .filterDate(start, end)
      .filterBounds(aoi)
      .map(harmonizeLandsat)
      .map(addNDVI);

    // Skip empty months
    var count = collection.size();
    if (count.getInfo() === 0) {
      //print('No images for', y + '-' + m);
      return;
    }

    // Compute median NDVI for the month
    var monthlyComposite = collection.median().clip(aoi)
      .select('NDVI')
      .set('year', y)
      .set('month', m);

    // Merge into the ImageCollection
    monthlyNDVIcol = monthlyNDVIcol.merge(ee.ImageCollection([monthlyComposite]));

    //print('NDVI composite stored for', y + '-' + m);
  });
}

// Inspect resulting ImageCollection
print('Monthly NDVI ImageCollection', monthlyNDVIcol);



//////////MONTHLY NDVICHART////////////////////
// ---------------------------
// COLORS (distinct for each year)
// ---------------------------
var colors = [
  'red','blue','green','orange','purple','brown','pink','cyan','magenta',
  'olive','navy','gold','teal','maroon','grey','darkgreen','darkred'
];

// ---------------------------
// REDUCE TO MEAN NDVI PER MONTH PER YEAR
// ---------------------------
var monthlyStats = monthlyNDVIcol.map(function(img){
  var mean = img.reduceRegion({
    reducer: ee.Reducer.mean(),
    geometry: aoi,
    scale: 30,
    maxPixels: 1e13
  }).get('NDVI');
  return ee.Feature(null, {
    year: img.get('year'),
    month: img.get('month'),
    NDVI: mean
  });
});

// Convert to list
monthlyStats = monthlyStats.aggregate_array('NDVI');
print('Monthly NDVI stats', monthlyStats);

// ---------------------------
// CHART: mean NDVI per month for each year
// ---------------------------
var chart = ui.Chart.feature.groups({
  features: monthlyNDVIcol.map(function(img){
    var mean = img.reduceRegion({
      reducer: ee.Reducer.mean(),
      geometry: aoi,
      scale: 30,
      maxPixels: 1e13
    }).get('NDVI');
    return ee.Feature(null, {
      month: img.get('month'),
      NDVI: mean,
      year: img.get('year')
    });
  }),
  xProperty: 'month',
  yProperty: 'NDVI',
  seriesProperty: 'year'
})
.setChartType('LineChart')
.setOptions({
  title: 'Monthly NDVI Trend (2010–2025)',
  hAxis: {title: 'Month', gridlines: {count: 12}},
  vAxis: {title: 'Mean NDVI'},
  lineWidth: 2,
  pointSize: 3,
  colors: colors,
  legend: {position: 'right'}
});

print(chart);





