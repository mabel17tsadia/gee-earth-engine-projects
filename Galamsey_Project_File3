// ---------------------------
// USER PARAMETERS
// ---------------------------
var startYear = 2010;
var endYear = 2025;
var AOI = aoi; // reuse AOI from previous steps
var bufferDistance = 200; // buffer around mined samples to avoid non-mined overlap
var nonMinedPointsCount = 100; // number of non-mined points per year

// Bands to use for classification
var bands = ['B2_p20','B3_p20','B4_p20','B5_p20','B6_p20','B7_p20','NDVI','NDWI','NDBI','GPI'];

// Random Forest parameters
var numTrees = 100;

// ---------------------------
// Mined Samples Dictionary (one per year)
// Replace with your actual FeatureCollection names
// ---------------------------
var minedSamplesDict = {
  2025: MiningSamples25,
  //2024: MiningSamples24,
  //2023: MiningSamples23,
  // ... add all years you have
};

// ---------------------------
// Visualization Parameters
// ---------------------------
var visParams = {min:0, max:1, palette:['#00FF00','#FF0000']}; // green = non-mined, red = mined

// ---------------------------
// Loop through each year
// ---------------------------
for (var year = startYear; year <= endYear; year++) {
  
  // Check if mined sample exists
  if (!(year in minedSamplesDict)) {
    print('No mined samples for year:', year);
    continue;
  }
  
  // Load mined samples and assign class = 1
  var minedSamples = minedSamplesDict[year].map(function(f){
    return f.set('class', 1);
  });
  
  // Buffer mined areas
  var minedBuffer = minedSamples.geometry().buffer(bufferDistance);
  
  // Generate random non-mined points
  var nonMinedSamples = ee.FeatureCollection.randomPoints({
    region: AOI.geometry().difference(minedBuffer),
    points: nonMinedPointsCount,
    seed: 42 + year // different seed per year
  }).map(function(f){ return f.set('class', 0); });
  
  // Merge mined + non-mined
  var labeledSamples = minedSamples.merge(nonMinedSamples);
  
  // --------------------------------------
  // Get composite with indices for this year
  // composites_with_indices should exist from previous steps
  // --------------------------------------
  if (!(year in composites_with_indices)) {
    print('No composite for year:', year);
    continue;
  }
  var composite = composites_with_indices[year];
  
  // --------------------------------------
  // Sample for classifier
  // --------------------------------------
  var training = composite.select(bands).sampleRegions({
    collection: labeledSamples,
    properties: ['class'],
    scale: 30
  });
  
  // Train/test split
  var withRandom = training.randomColumn('random', 42);
  var trainSet = withRandom.filter(ee.Filter.lt('random', 0.7));
  var testSet  = withRandom.filter(ee.Filter.gte('random', 0.7));
  
  print('Year:', year, 'Train size:', trainSet.size(), 'Test size:', testSet.size());
  
  // --------------------------------------
  // Train Random Forest classifier
  // --------------------------------------
  var rf = ee.Classifier.smileRandomForest(numTrees).setOutputMode('CLASSIFICATION');
  var trainedRF = rf.train({
    features: trainSet,
    classProperty: 'class',
    inputProperties: bands
  });
  print('✅ Random Forest trained for year', year);
  
  // --------------------------------------
  // Evaluate classifier
  // --------------------------------------
  var validated = testSet.classify(trainedRF);
  var cm = validated.errorMatrix('class','classification');
  print('=== CONFUSION MATRIX (Year ' + year + ') ===');
  print(cm);
  print('Accuracy:', cm.accuracy());
  print('Kappa:', cm.kappa());
  
  // --------------------------------------
  // Classify composite (Active Mining Map)
  // --------------------------------------
  var classified = composite.select(bands).classify(trainedRF);
  
  // Add layer to map (unchecked by default)
  Map.addLayer(classified.clip(AOI), visParams, 'Active Mining ' + year, false);
  
  // --------------------------------------
  // Optional export
  // --------------------------------------
  Export.image.toDrive({
    image: classified.clip(AOI),
    description: 'Active_Mining_' + year + '_RF',
    folder: 'GEE_Exports',
    fileNamePrefix: 'Active_Mining_' + year + '_RF',
    region: AOI.geometry(),
    scale: 30,
    maxPixels: 1e13
  });
  
}

