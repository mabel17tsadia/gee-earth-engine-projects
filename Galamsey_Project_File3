    print("No classified map for:", yr);
    continue;
  }

  var classifiedImg = classifiedDict[yr];

  // Extract degraded (mining) pixels
  var degraded = classifiedImg.eq(1).selfMask();

  // Pixel area
  var pixelArea = ee.Image.pixelArea();

  // Compute degraded area inside AOI
  var degradedArea = pixelArea.updateMask(degraded)
    .reduceRegion({
      reducer: ee.Reducer.sum(),
      geometry: AOI,
      scale: 30,
      maxPixels: 1e13
    });

  // Convert to hectares
  var areaHa = ee.Number(degradedArea.get("area")).divide(10000);

  // Print to console
  //print("Degraded Area (" + yr + "): ", areaHa);
  
  // Add to legend immediately
legendPanel.add(ui.Label(yr + ': ' + areaHa.format('%.2f').getInfo() + ' ha', 
  {fontSize: '13px', margin: '2px 0 2px 0'}));

  // Append to lists
  yearList = yearList.add(yr);
  areaList = areaList.add(areaHa);
}


