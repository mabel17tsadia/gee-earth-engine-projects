// 1. DEFINE STUDY AREA AND DATES


var start_date = '2024-01-01';
var end_date = '2024-12-01';
var scale = 10; // Resolution in meters

// 2. LOAD AND PRE-PROCESS SATELLITE DATA
// Use a more advanced Sentinel-2 collection with pre-computed cloud scores.
function maskS2clouds(image) {
  var qa = image.select('QA60');
  var cloudBitMask = 1 << 10;
  var cirrusBitMask = 1 << 11;
  var mask = qa.bitwiseAnd(cloudBitMask).eq(0).and(qa.bitwiseAnd(cirrusBitMask).eq(0));
  return image.updateMask(mask).divide(10000);
}

// ---------------------- FIX STARTS HERE ------------------------------------
// Option A: Use a simpler cloud filter.
var s2 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(roi)
  .filterDate(start_date, end_date)
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 5)) // Increased threshold to 20%
  .map(maskS2clouds)
  .select(['B2', 'B3', 'B4', 'B5', 'B6', 'B7', 'B8', 'B8A', 'B11', 'B12'])
  .median();

// To be more robust, let's also filter the image collection itself.
var s1 = ee.ImageCollection('COPERNICUS/S1_GRD')
  .filterBounds(roi)
  .filterDate(start_date, end_date)
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VV'))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VH'))
  .filter(ee.Filter.eq('instrumentMode', 'IW'))
  .select(['VV', 'VH'])
  .median()
  .unitScale(-1, 0.2);

// Check if the S2 image collection is empty
var s2_count = s2.bandNames().size();
print('S2 bands available:', s2_count);

// ---------------------- FIX ENDS HERE ------------------------------------

// 3. CREATE A FEATURE STACK
var featureStack = s2.addBands(s1);

// 4. CREATE TRAINING DATA
var trainingData = Water.merge(DenseV).merge(LightV).merge(Settle).merge(Bareness);

// 5. CHOOSE AND TRAIN A CLASSIFIER (Random Forest)
var bands = featureStack.bandNames();

// Sample the `featureStack` at the locations of the training data.
var sampledData = featureStack.sampleRegions({
  collection: trainingData.randomColumn(),
  properties: ['class'],
  scale: scale,
  tileScale: 16 // Set a higher tileScale to handle large collections
});

// Check the number of total samples
print('Total samples before filtering:', sampledData.size());

// Filter out samples where properties are missing (e.g., on masked pixels)
var filteredData = sampledData.filter(ee.Filter.notNull(featureStack.bandNames()));

// Apply .randomColumn() *after* sampling and filtering
var filteredDataWithRandom = filteredData.randomColumn('random');

// Split into training and validation
var trainingSet = filteredDataWithRandom.filter(ee.Filter.lt('random', 0.7));
var validationSet = filteredDataWithRandom.filter(ee.Filter.gte('random', 0.7));

// Print results
print('Total valid samples:', filteredDataWithRandom.size());
print('Training samples:', trainingSet.size());
print('Validation samples:', validationSet.size());

// Train the classifier on the new trainingSet
var trainedClassifier = ee.Classifier.smileRandomForest({numberOfTrees: 100})
  .train({
    features: trainingSet,
    classProperty: 'class',
    inputProperties: bands
  });

// 6. PERFORM CLASSIFICATION
var classified = featureStack.classify(trainedClassifier);

print('Variable Importance:', trainedClassifier.explain());

// Define visualization palettes for the classified image
// The classes are 1, 2, 3, 4, 5, so min and max should reflect that.
var visParams = {
  min: 1,
  max: 5,
  palette: ['0000FF', '008000', '97FF76', 'FF0000', '8B4513']
};

var classNames = [
  'Water',
  'Dense Vegetation',
  'Light Vegetation',
  'Settlement',
  'Bareness'
];

// 7. DISPLAY RESULTS
Map.centerObject(roi, 12);
Map.addLayer(featureStack, {bands: ['B4', 'B3', 'B2'], min: 0.0, max: 0.3}, 'Sentinel-2 RGB');
Map.addLayer(s1, {bands: ['VV', 'VH', 'VV'], min: -20, max: 0}, 'Sentinel-1 VV/VH');
Map.addLayer(classified, visParams, 'Land Cover Classification');

// --------------------------------------------------------------------------------------------------

// Accuracy Assessment (Corrected)

// Classify the validation points
var validation = validationSet.classify(trainedClassifier);

// Get a confusion matrix and print the results
var confusionMatrix = validation.errorMatrix('class', 'classification');
print('Confusion Matrix:', confusionMatrix);
print('Overall Accuracy:', confusionMatrix.accuracy());
print('Kappa Coefficient:', confusionMatrix.kappa());

// --------------------------------------------------------------------------------------------------

//Area Calculation & Legend

// Calculate the area of each land cover class
var areaImage = ee.Image.pixelArea().addBands(classified.rename('class'));

// 2. Reduce the area by 'class' (grouped sum of pixel areas)
var classArea = areaImage.reduceRegion({
  reducer: ee.Reducer.sum().group({
    groupField: 1,     // refers to 'class' band
    groupName: 'class'
  }),
  geometry: roi,
  scale: scale,
  maxPixels: 1e13
});

// 3. Get the list of groups (classes + their summed area)
var areaList = ee.List(classArea.get('groups'));

// (Optional) Print raw data to debug
print('Raw area list:', areaList);

// 4. Map through the area list and calculate area in hectares with class name
var areaInHa = areaList.map(function(item) {
  item = ee.Dictionary(item);
  var area_m2 = ee.Number(item.get('sum'));
  var class_id = ee.Number(item.get('class'));
  var area_ha = area_m2.divide(10000); // Convert to hectares

  // Safely retrieve class name (only if within valid index)
  return ee.Algorithms.If(
    class_id.gte(1).and(class_id.lte(classNames.length)),
    ee.String(ee.List(classNames).get(class_id.subtract(1)))
      .cat(': ')
      .cat(area_ha.format('%.2f'))
      .cat(' ha'),
    ee.String('Unknown class ').cat(class_id.format()).cat(': ').cat(area_ha.format('%.2f')).cat(' ha')
  );
});

// 5. Print the final results
print('area by Class (in hectares):', areaInHa);

// Create a legend for the map
var legend = ui.Panel({
  style: {
    position: 'bottom-left',
    padding: '8px 15px'
  }
});

var legendTitle = ui.Label({
  value: 'Land Cover Classes',
  style: {
    fontWeight: 'bold',
    fontSize: '16px',
    margin: '0 0 4px 0',
    padding: '0'
  }
});

legend.add(legendTitle);

// Define classes and colors
var colorList = visParams.palette;
var makeRow = function(color, name) {
  var colorBox = ui.Label({
    style: {
      backgroundColor: color,
      padding: '8px',
      margin: '0 0 4px 0'
    }
  });
  var description = ui.Label({
    value: name,
    style: {margin: '0 0 4px 6px'}
  });
  return ui.Panel({
    widgets: [colorBox, description],
    layout: ui.Panel.Layout.Flow('horizontal')
  });
};

for (var i = 0; i < classNames.length; i++) {
  legend.add(makeRow(colorList[i], classNames[i]));
}

Map.add(legend);

