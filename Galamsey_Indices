// ========================================================
// : Multi-Index Analysis for Tarkwa Nsuaem, Ghana 
// Indices: NDVI, EVI, NDWI, MNDWI, NDBI, NBR, BSI, IOI, CMR, LST, DEM, GPI (Gold)
// ========================================================

// -------------------------------------------------------
// 1. LOAD AREA OF INTEREST (AOI)
// -------------------------------------------------------
var aoi = ee.FeatureCollection('projects/mabeltsadia/assets/Prestea_Huni_Valley_WR');
Map.centerObject(aoi, 11);

// Optional: Clip all data to AOI
function clipToAOI(image) {
  return image.clip(aoi);
}

// -------------------------------------------------------
// 2. LOAD LANDSAT 8 (OLI/TIRS) - SURFACE REFLECTANCE
// -------------------------------------------------------
var landsat = ee.ImageCollection('LANDSAT/LC08/C02/T1_L2')
    .filterBounds(aoi)
    .filterDate('2023-01-01', '2023-12-31')  // Adjust date range
    .filter(ee.Filter.lt('CLOUD_COVER', 20))
    .map(function(img) {
      // Apply scaling factors for SR
      var opticalBands = img.select('SR_B.').multiply(0.0000275).add(-0.2);
      var thermalBand = img.select('ST_B10').multiply(0.00341802).add(149.0); // K
      return img.addBands(opticalBands, null, true)
                .addBands(thermalBand.rename('LST'))
                .set('system:time_start', img.get('system:time_start'));
    })
    .median()  // Composite
    .clipToCollection(aoi);

print('Landsat Composite', landsat);

// -------------------------------------------------------
// 3. LOAD DEM (SRTM)
// -------------------------------------------------------
var dem = ee.Image('USGS/SRTMGL1_003').select('elevation').clipToCollection(aoi);

// -------------------------------------------------------
// 4. INDEX CALCULATION FUNCTIONS
// -------------------------------------------------------

// Helper: Normalize band values if needed
function normalize(image, band1, band2) {
  return image.expression('(b1 - b2) / (b1 + b2)', {
    'b1': image.select(band1),
    'b2': image.select(band2)
  }).rename(band1 + '_' + band2);
}

// --- VEGETATION ---
var ndvi = normalize(landsat, 'SR_B5', 'SR_B4').rename('NDVI'); // NIR - Red / NIR + Red
var evi = landsat.expression(
  '2.5 * ((NIR - RED) / (NIR + 6 * RED - 7.5 * BLUE + 1))', {
    'NIR': landsat.select('SR_B5'),
    'RED': landsat.select('SR_B4'),
    'BLUE': landsat.select('SR_B2')
  }).rename('EVI');

// --- WATER ---
var ndwi = normalize(landsat, 'SR_B3', 'SR_B5').rename('NDWI'); // Green - NIR
var mndwi = normalize(landsat, 'SR_B3', 'SR_B6').rename('MNDWI'); // Green - SWIR1

// --- BUILT-UP ---
var ndbi = normalize(landsat, 'SR_B6', 'SR_B5').rename('NDBI'); // SWIR1 - NIR

// --- BURN / DEGRADATION ---
var nbr = normalize(landsat, 'SR_B5', 'SR_B7').rename('NBR'); // NIR - SWIR2
var bsi = landsat.expression(
  '((SWIR1 + RED) - (NIR + BLUE)) / ((SWIR1 + RED) + (NIR + BLUE))', {
    'SWIR1': landsat.select('SR_B6'),
    'RED': landsat.select('SR_B4'),
    'NIR': landsat.select('SR_B5'),
    'BLUE': landsat.select('SR_B2')
  }).rename('BSI');

// --- MINERAL INDICES ---
var ioi = normalize(landsat, 'SR_B4', 'SR_B2').rename('IOI'); // Red / Blue → Iron Oxide
var cmr = normalize(landsat, 'SR_B6', 'SR_B7').rename('CMR'); // SWIR1 / SWIR2 → Clay

// --- GOLD MINERALIZATION INDEX (NEW) ---
// Gold Potential Index (GPI): Highlights Fe-oxide and Al-OH alterations associated with gold
// Formula: ( (Red/Blue) + (SWIR1/SWIR2) ) / (Green + NIR)  [Normalized for emphasis]
var ferric = landsat.expression('(RED / BLUE)', {
  'RED': landsat.select('SR_B4'),
  'BLUE': landsat.select('SR_B2')
});
var aloh = landsat.expression('(SWIR1 / SWIR2)', {
  'SWIR1': landsat.select('SR_B6'),
  'SWIR2': landsat.select('SR_B7')
});
var gpi = landsat.expression('((Fe + AlOH) / (GREEN + NIR))', {
  'Fe': ferric,
  'AlOH': aloh,
  'GREEN': landsat.select('SR_B3'),
  'NIR': landsat.select('SR_B5')
}).rename('GPI');

// Optional: Binary mask for high-potential zones (GPI > 1)
var goldHotspots = gpi.gt(1).rename('Gold_Hotspots');

// --- LST (already scaled in Landsat prep) ---
var lst = landsat.select('LST');

// -------------------------------------------------------
// 5. COMBINE ALL INDICES INTO A SINGLE IMAGE
// -------------------------------------------------------
var indices = ee.Image.cat([
  ndvi, evi,
  ndwi, mndwi,
  ndbi,
  nbr, bsi,
  ioi, cmr, gpi,  // Added GPI
  lst,
  dem
]).float();

// Add to map with proper visualization
Map.addLayer(indices.select('NDVI'), {min: -1, max: 1, palette: ['brown', 'yellow', 'green']}, 'NDVI', false);
Map.addLayer(indices.select('EVI'),  {min: -1, max: 1, palette: ['brown', 'yellow', 'darkgreen']}, 'EVI', false);
Map.addLayer(indices.select('NDWI'), {min: -1, max: 1, palette: ['white', 'blue']}, 'NDWI', false);
Map.addLayer(indices.select('MNDWI'),{min: -1, max: 1, palette: ['white', 'cyan', 'blue']}, 'MNDWI', false);
Map.addLayer(indices.select('NDBI'), {min: -1, max: 1, palette: ['gray', 'orange', 'red']}, 'NDBI', false);
Map.addLayer(indices.select('NBR'),  {min: -1, max: 1, palette: ['red', 'yellow', 'green']}, 'NBR', false);
Map.addLayer(indices.select('BSI'),  {min: -1, max: 1, palette: ['purple', 'white', 'green']}, 'BSI', false);
Map.addLayer(indices.select('IOI'),  {min: 0, max: 2, palette: ['blue', 'white', 'red']}, 'IOI (Iron Oxide)', false);
Map.addLayer(indices.select('CMR'),  {min: 0.8, max: 1.2, palette: ['brown', 'white', 'green']}, 'CMR (Clay)', false);
Map.addLayer(indices.select('GPI'),  {min: 0.5, max: 2, palette: ['green', 'yellow', 'red']}, 'GPI (Gold Potential)', true);  // Highlighted
Map.addLayer(goldHotspots, {palette: ['white', 'gold']}, 'Gold Hotspots (GPI >1)', false);
Map.addLayer(indices.select('LST'),  {min: 290, max: 320, palette: ['blue', 'white', 'red']}, 'LST (K)', false);
Map.addLayer(dem, {min: 0, max: 500, palette: ['green', 'yellow', 'brown']}, 'DEM (m)', true);

// -------------------------------------------------------
// 6. EXPORT MULTI-BAND GEO-TIFF (Optional)
// -------------------------------------------------------
Export.image.toDrive({
  image: indices.addBands(goldHotspots),  // Include hotspots band
  description: 'Tarkwa_Nsuaem_MultiIndex_Gold_2023',
  folder: 'GEE_Exports',
  fileNamePrefix: 'Tarkwa_Nsuaem_Indices_Gold_2023',
  region: aoi.geometry(),
  scale: 30,
  crs: 'EPSG:32630',  // UTM Zone 30N (Ghana)
  maxPixels: 1e10,
  fileFormat: 'GeoTIFF',
  formatOptions: {
    cloudOptimized: true
  }
});

print('Export task created: Tarkwa_Nsuaem_MultiIndex_Gold_2023');
print('Check Tasks tab to run export.');

