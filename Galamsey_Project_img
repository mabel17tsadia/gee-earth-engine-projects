// ✅ Define a helper that safely renames only if bands exist
function safeRename(image, oldBands, newBands) {
  var bands = image.bandNames();
  var present = ee.List(oldBands).map(function(b) { return bands.contains(b); });
  var allExist = ee.List(present).reduce(ee.Reducer.min());
  return ee.Image(ee.Algorithms.If(allExist, image.select(oldBands, newBands), null));
}

// Landsat 5
function renameL5(image) {
  return safeRename(image, ['SR_B1', 'SR_B2', 'SR_B3', 'SR_B4', 'SR_B5', 'SR_B7'], 
                           ['B1','B2','B3','B4','B5','B7']);
}

// Landsat 7
function renameL7(image) {
  return safeRename(image, ['SR_B1', 'SR_B2', 'SR_B3', 'SR_B4', 'SR_B5', 'SR_B7'],
                           ['B1','B2','B3','B4','B5','B7']);
}

// Landsat 8
function renameL8(image) {
  return safeRename(image, ['SR_B2','SR_B3','SR_B4','SR_B5','SR_B6','SR_B7'],
                           ['B1','B2','B3','B4','B5','B7']);
}

// Sentinel-2
function renameS2(image) {
  return safeRename(image, ['B2','B3','B4','B8','B11','B12'],
                           ['B1','B2','B3','B4','B5','B7']);
}

// ✅ Apply renaming only if collection isn’t empty
function mapIfNotEmpty(collection, func) {
  return ee.ImageCollection(ee.Algorithms.If(collection.size().gt(0),
                                             collection.map(func),
                                             ee.ImageCollection([])));
}

var l5_h = mapIfNotEmpty(l5_clean, renameL5);
var l7_h = mapIfNotEmpty(l7_clean, renameL7);
var l8_h = mapIfNotEmpty(l8_clean, renameL8);
var s2_h = mapIfNotEmpty(s2_clean, renameS2);

// ✅ Resample Sentinel safely
s2_h = ee.ImageCollection(ee.Algorithms.If(s2_h.size().gt(0),
  s2_h.map(function(img) {
    return img.resample('bilinear').reproject({
      crs: ee.Image(l8_clean.first()).projection(),
      scale: 30
    });
  }),
  ee.ImageCollection([])
));

// ✅ Merge all available collections
var all_harmonized = l5_h.merge(l7_h).merge(l8_h).merge(s2_h);

// ✅ Print verification
print('✅ Harmonized collection ready. Image count:', all_harmonized.size());
print('Sample band names (first image):', ee.Image(all_harmonized.first()).bandNames());
