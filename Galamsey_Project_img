// -------------------------------------------------------
// Safe rename helper
function safeRename(image, oldBands, newBands) {
  var bands = image.bandNames();
  var hasAll = ee.List(oldBands).map(function(b){ return bands.contains(b); });
  var ok = ee.List(hasAll).reduce(ee.Reducer.min());
  return ee.Algorithms.If(ok, image.select(oldBands, newBands), null);
}

// -------------------------------------------------------
// Rename functions
function renameL5(image) {
  return safeRename(image,
    ['SR_B1','SR_B2','SR_B3','SR_B4','SR_B5','SR_B7'],
    ['B1','B2','B3','B4','B5','B7']);
}

function renameL7(image) {
  return safeRename(image,
    ['SR_B1','SR_B2','SR_B3','SR_B4','SR_B5','SR_B7'],
    ['B1','B2','B3','B4','B5','B7']);
}
function renameL8(image) {
  return safeRename(image,
    ['SR_B1','SR_B2','SR_B3','SR_B4','SR_B5','SR_B7'],
    ['B1','B2','B3','B4','B5','B7']);
}
function renameL9(image) {
  return safeRename(image,
    ['SR_B2','SR_B3','SR_B4','SR_B5','SR_B6','SR_B7'],
    ['B1','B2','B3','B4','B5','B7']);
}
function renameS2(image) {
  return safeRename(image,
    ['B2','B3','B4','B8','B11','B12'],
    ['B1','B2','B3','B4','B5','B7']);
}

// -------------------------------------------------------
// Apply renaming safely
function renameAndClean(col, fn) {
  return col.map(function(img) {
    var renamed = fn(img);
    return ee.Image(ee.Algorithms.If(renamed, renamed, ee.Image()));
  }).filter(ee.Filter.listContains('system:band_names','B1'));
}

function forceFloat(col) {
  return col.map(function(img) { return img.toFloat(); });
}

var l5_h = forceFloat(renameAndClean(l5_clean_fixed, renameL5));
var l7_h = forceFloat(renameAndClean(l7_clean_fixed, renameL7));
var l8_h = forceFloat(renameAndClean(l8_clean, renameL8));
var l9_h = forceFloat(renameAndClean(l9_clean, renameL9));
var s2_h = forceFloat(renameAndClean(s2_clean, renameS2));

