// 6. SENTINEL-2: ALREADY L2A (BOA) → JUST MASK
var s2 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(Prestea)
  .filterDate('2017-01-01', '2025-12-31');

var s2_sample = s2.first();
print('Sentinel-2 bands:', s2_sample.bandNames());

function maskS2(image) {
  var scl = image.select('SCL');
  var good = scl.eq(4)  // vegetation
             .or(scl.eq(5))  // bare soil
             .or(scl.eq(6))  // water
             .or(scl.eq(7))  // unclassified
             .or(scl.eq(11)); // snow (rare)
  return image.updateMask(good)
              .select(['B2','B3','B4','B5','B6','B7','B8','B8A','B11','B12']);
}

var s2_clean = s2.map(maskS2);
print('Sentinel-2 clean:', s2_clean.size());

