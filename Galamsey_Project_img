print('🟡 IMAGE HARMONIZATION BEGINS');

// -------------------------------------------------------
// 0️⃣  REMOVE CORRUPT OR INCOMPLETE LANDSAT-7 SCENES
var badL7 = [
  'LE07_193056_20220909'  // known corrupt image
];
var l7_clean_fixed = l7_clean.filter(ee.Filter.inList('system:index', badL7).not());

// -------------------------------------------------------
// 1️⃣ Safe rename helper
function safeRename(image, oldBands, newBands) {
  var bands = image.bandNames();
  var hasAll = ee.List(oldBands).map(function(b){ return bands.contains(b); });
  var ok = ee.List(hasAll).reduce(ee.Reducer.min());
  return ee.Algorithms.If(ok, image.select(oldBands, newBands), null);
}

// -------------------------------------------------------
// 2️⃣ Rename functions
function renameL7(image) {
  return safeRename(image,
    ['SR_B1','SR_B2','SR_B3','SR_B4','SR_B5','SR_B7'],
    ['B1','B2','B3','B4','B5','B7']);
}
function renameL8(image) {
  return safeRename(image,
    ['SR_B1','SR_B2','SR_B3','SR_B4','SR_B5','SR_B7'],
    ['B1','B2','B3','B4','B5','B7']);
}
function renameL9(image) {
  return safeRename(image,
    ['SR_B2','SR_B3','SR_B4','SR_B5','SR_B6','SR_B7'],
    ['B1','B2','B3','B4','B5','B7']);
}
function renameS2(image) {
  return safeRename(image,
    ['B2','B3','B4','B8','B11','B12'],
    ['B1','B2','B3','B4','B5','B7']);
}

// -------------------------------------------------------
// 3️⃣ Apply renaming safely
function renameAndClean(col, fn) {
  return col.map(function(img) {
    var renamed = fn(img);
    return ee.Image(ee.Algorithms.If(renamed, renamed, ee.Image()));
  }).filter(ee.Filter.listContains('system:band_names','B1'));
}

var l7_h = renameAndClean(l7_clean_fixed, renameL7);
var l8_h = renameAndClean(l8_clean, renameL8);
var l9_h = renameAndClean(l9_clean, renameL9);
var s2_h = renameAndClean(s2_clean, renameS2);

// -------------------------------------------------------
// 4️⃣ Resample Sentinel-2 to 30 m
s2_h = s2_h.map(function(img){
  return img.resample('bilinear')
            .reproject({crs: ee.Image(l8_clean.first()).projection(), scale: 30});
});

// -------------------------------------------------------
// 5️⃣ Merge all harmonized collections
var all_harmonized = l7_h.merge(l8_h).merge(l9_h).merge(s2_h);

// -------------------------------------------------------
print('✅ Harmonized collection ready. Image count:', all_harmonized.size());
print('Sample band names (first valid image):', ee.Image(all_harmonized.first()).bandNames());

Map.addLayer(
  all_harmonized.median().clip(Prestea),
  {bands:['B3','B2','B1'], min:0, max:0.3, gamma:1.3},
  'Harmonized Composite (Preview)'
);

