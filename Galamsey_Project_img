// SAFE INSPECTION: Print collection size + band names only
// -------------------------------------------------------

function inspectCollection(col, name) {
  var count = col.size();
  print(name + ' image count:', count);
  
  // Safely handle empty collections
  var firstImg = ee.Image(col.first());
  var bands = ee.Algorithms.If(
    count.gt(0),
    firstImg.bandNames(),
    'No images found in this collection'
  );
  
  print(name + ' bands:', bands);
}

// Run inspection for each Landsat and Sentinel-2 collection
