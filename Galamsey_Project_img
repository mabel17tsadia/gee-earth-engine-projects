print('BAND NAMES ONLY');

function printBandNames(col, name) {
  var count = col.size();
  // Get the first image safely
  var firstImg = ee.Image(col.first());
  
  // Only print band names if there are images
  var bands = ee.Algorithms.If(
    count.gt(0),
    firstImg.bandNames(),
    'No images found'
  );
  
  print(name + ':', bands);
}

// Run for each collection
printBandNames(landsat7, 'Landsat 7');
printBandNames(landsat8, 'Landsat 8');
printBandNames(landsat9, 'Landsat 9');
printBandNames(s2, 'Sentinel-2');




