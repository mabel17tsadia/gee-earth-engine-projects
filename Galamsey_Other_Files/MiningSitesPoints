// ============================================================================
// ACTIVE MINING DETECTION (2010–2024)
// Landsat 5, 7, 8 Surface Reflectance - Dry season composites
// Harmonized bands + NDVI + NDMI
// ============================================================================

// 1. INPUT DATA
var minedPoints = miningSites.map(function(f) { return f.set('class', 1); });
var nonMinedPoints = non_mined.map(function(f) { return f.set('class', 0); });
var labeledPoints = minedPoints.merge(nonMinedPoints);
print('Total labeled points:', labeledPoints.size());

var AOI = ee.FeatureCollection('projects/mabeltsadia/assets/Tarkwa_Nsuaem_WR');

// -----------------------------------------------------------------------------
// 2. FUNCTION: Harmonize Landsat Sensors (L5, L7, L8)
// -----------------------------------------------------------------------------
function harmonizeLandsat(img) {
  var sensor = ee.String(img.get('SPACECRAFT_ID'));
  
  // Landsat 5 and 7 bands
  var l57 = img.select(['SR_B1','SR_B2','SR_B3','SR_B4','SR_B5','SR_B7'], 
                       ['Blue','Green','Red','NIR','SWIR1','SWIR2']);
  // Landsat 8 bands
  var l8 = img.select(['SR_B2','SR_B3','SR_B4','SR_B5','SR_B6','SR_B7'], 
                      ['Blue','Green','Red','NIR','SWIR1','SWIR2']);
  
  // Choose proper mapping
  var optical = ee.Image(ee.Algorithms.If(sensor.equals('LANDSAT_8'), l8, l57))
      .multiply(0.0000275).add(-0.2); // Apply scaling
  
  return optical.copyProperties(img, img.propertyNames());
}

// -----------------------------------------------------------------------------
// 3. FUNCTION: Get Annual Landsat Composite
// -----------------------------------------------------------------------------
function getLandsatComposite(year) {
  var start = ee.Date.fromYMD(year, 12, 1);
  var end = ee.Date.fromYMD(year + 1, 3, 31);

  var l5 = ee.ImageCollection('LANDSAT/LT05/C02/T1_L2')
    .filterDate(start, end)
    .filterBounds(AOI)
    .map(harmonizeLandsat);

  var l7 = ee.ImageCollection('LANDSAT/LE07/C02/T1_L2')
    .filterDate(start, end)
    .filterBounds(AOI)
    .map(harmonizeLandsat);

  var l8 = ee.ImageCollection('LANDSAT/LC08/C02/T1_L2')
    .filterDate(start, end)
    .filterBounds(AOI)
    .map(harmonizeLandsat);

  // Merge all sensors
  var merged = l5.merge(l7).merge(l8);
  
  // Median composite
  var composite = merged.median().clip(AOI);

  // Add indices (NDVI & NDMI)
  composite = composite
    .addBands(composite.normalizedDifference(['NIR','Red']).rename('NDVI'))
    .addBands(composite.normalizedDifference(['SWIR1','NIR']).rename('NDMI'));

  return composite;
}

// -----------------------------------------------------------------------------
// 4. YEARLY LOOP (2010–2024)
// -----------------------------------------------------------------------------
var years = ee.List.sequence(2010, 2024);
var yearList = years.getInfo();

// Bands to use for classification
var bands = ['Blue','Green','Red','NIR','SWIR1','SWIR2','NDVI','NDMI'];

for (var i = 0; i < yearList.length; i++) {
  var y = yearList[i];
  print('Processing year:', y);

  var composite = getLandsatComposite(y);

  // Sample training data
  var training = composite.select(bands).sampleRegions({
    collection: labeledPoints,
    properties: ['class'],
    scale: 30,
    tileScale: 4
  });

  // Train Random Forest classifier
  var rf = ee.Classifier.smileRandomForest(100).train({
    features: training,
    classProperty: 'class',
    inputProperties: bands
  });

  // Classify image
  var classified = composite.select(bands).classify(rf);
  var activeMining = classified.eq(1).rename('ActiveMining_' + y);

  // Add to map (optional)
  Map.addLayer(activeMining.selfMask(),
    {palette:['red']}, 'Active Mining ' + y, false);

  // Export to Google Drive
  Export.image.toDrive({
    image: activeMining,
    description: 'Tarkwa_ActiveMining_' + y,
    folder: 'GEE_MiningInference',
    fileNamePrefix: 'Tarkwa_ActiveMining_' + y,
    region: AOI.geometry(),
    scale: 30,
    crs: 'EPSG:32630',
    maxPixels: 1e13
  });
}

print('✅ Landsat-only active mining maps (2010–2024) ready for export.');
