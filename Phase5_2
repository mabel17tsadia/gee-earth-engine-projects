// Compute Pearson correlation manually over yearly values
function pearsonCorrelation(xList, yList){
  var n = xList.length;
  var xMean = xList.reduce(ee.Reducer.mean());
  var yMean = yList.reduce(ee.Reducer.mean());

  var cov = ee.Number(0);
  var xVar = ee.Number(0);
  var yVar = ee.Number(0);

  for (var i=0; i<n; i++){
    var xi = ee.Number(xList.get(i));
    var yi = ee.Number(yList.get(i));
    cov = cov.add(xi.subtract(xMean).multiply(yi.subtract(yMean)));
    xVar = xVar.add(xi.subtract(xMean).pow(2));
    yVar = yVar.add(yi.subtract(yMean).pow(2));
  }
  return cov.divide(xVar.sqrt().multiply(yVar.sqrt()));
}

// Remove nulls
