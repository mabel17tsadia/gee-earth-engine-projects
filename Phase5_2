// 7. Correlate CO anomalies with Mined Area
// ---------------------------

// Compute yearly mean CO anomalies
var yearlyCOmean = ee.List.sequence(startYear, endYear).map(function(y) {
  var imgs = CO_anom.filter(ee.Filter.eq('year', y));
  return ee.Algorithms.If(
    imgs.size().gt(0),
    imgs.mean().reduceRegion({
      reducer: ee.Reducer.mean(),
      geometry: AOI,
      scale: 7000,
      maxPixels: 1e10
    }).get('ANOM_CO'),
    null
  );
});

// Mined area from variable areaDict (assumes it exists)
var minedAreas = ee.List.sequence(startYear, endYear).map(function(y) {
  return ee.Number(areaDict.get(ee.String(y)));
});

// Pair CO anomalies with mined area
var paired = ee.List.sequence(0, yearlyCOmean.size().subtract(1)).map(function(i) {
  return ee.List([ ee.Number(yearlyCOmean.get(i)),
                   ee.Number(minedAreas.get(i)) ]);
});

var pairedFiltered = paired.map(function(p) {
  var coVal   = ee.List(p).get(0);
  var areaVal = ee.List(p).get(1);
  // Keep only if both values are not null
  return ee.Algorithms.If(
    ee.Algorithms.IsNumber(coVal).and(ee.Algorithms.IsNumber(areaVal)),
    p,
    null
  );
}).removeAll([null]);  // remove null entries


// Extract x (CO anomaly) and y (mined area) lists
var x = pairedFiltered.map(function(p){ return ee.Number(ee.List(p).get(0)); });
var y = pairedFiltered.map(function(p){ return ee.Number(ee.List(p).get(1)); });

// Compute Pearson correlation manually
var meanX = ee.Number(x.reduce(ee.Reducer.mean()));
var meanY = ee.Number(y.reduce(ee.Reducer.mean()));

var covXY = ee.Number(
  ee.List.sequence(0, x.size().subtract(1)).map(function(i) {
    var xi = ee.Number(x.get(i)).subtract(meanX);
    var yi = ee.Number(y.get(i)).subtract(meanY);
    return xi.multiply(yi);
  }).reduce(ee.Reducer.sum())
);

var stdX = ee.Number(x.reduce(ee.Reducer.stdDev()));
var stdY = ee.Number(y.reduce(ee.Reducer.stdDev()));

// Pearson correlation
var pearson = covXY.divide(stdX.multiply(stdY).multiply(x.size().subtract(1)));

print('Pearson correlation CO anomaly vs Mined Area:', pearson);

