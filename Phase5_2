// ---------------------------
// 2. Monthly mean aggregation for CH4/CO
// ---------------------------
function monthlyMean(collection, bandName) {
  var years  = ee.List.sequence(startYear, endYear);
  var months = ee.List.sequence(1, 12);

  var images = years.map(function(y) {
    return months.map(function(m) {
      var start = ee.Date.fromYMD(y, m, 1);
      var end   = start.advance(1, 'month');

      var monthly = collection.filterDate(start, end);
      return ee.Algorithms.If(
        monthly.size().gt(0),
        monthly.mean().rename(bandName)
          .set('year', y)
          .set('month', m)
          .set('system:time_start', start.millis()),
        null
      );
    });
  }).flatten();

  return ee.ImageCollection.fromImages(images)
           .filter(ee.Filter.notNull(['system:time_start']));
}

var monthlyCH4 = monthlyMean(ch4, "CH4");
var monthlyCO  = monthlyMean(co,  "CO");

// ---------------------------
// 3. Compute anomalies (CH4 & CO)
// ---------------------------
function computeAnomaly(ic, band) {
  var longTermMean = ic.mean().rename('LTmean_' + band);
  return ic.map(function(img) {
    return img.subtract(longTermMean)
              .rename('ANOM_' + band)
              .copyProperties(img,
                ['year', 'month', 'system:time_start']
              );
  });
}

var CH4_anom = computeAnomaly(monthlyCH4, "CH4");
var CO_anom  = computeAnomaly(monthlyCO,  "CO");

