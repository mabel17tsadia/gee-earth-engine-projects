  // Exclude cloud, cirrus, cloud shadow, snow/ice
  var mask = scl.neq(3)  // cloud shadows
             .and(scl.neq(8))  // clouds
             .and(scl.neq(9))  // cirrus (if coded)
             .and(scl.neq(10)); // snow/ice (if present)
