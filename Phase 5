var weiLabels = ['0.00 – 0.10','0.10 – 0.20','0.20 – 0.30','0.30 – 0.40','≥ 0.40 (High)'];
for(var i=0;i<weiColors.length;i++){
  weiLegend.add(ui.Panel([ui.Label('', {backgroundColor:weiColors[i], width:'60px', height:'20px', margin:'4px 8px'}), ui.Label(weiLabels[i], {margin:'4px 0px'})], ui.Panel.Layout.Flow('horizontal')));
