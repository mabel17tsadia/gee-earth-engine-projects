///////////////////////////////
// TARKWA-NSUAEM: SENTINEL-5P CH₄ + CO – FULLY FIXED & ROBUST
// Works even when some months have zero data
///////////////////////////////

//var aoi = ee.FeatureCollection('projects/ghana-project-73326/assets/Tarkiwa_Nsuaem');
Map.centerObject(aoi, 10);
Map.setOptions('SATELLITE');
Map.addLayer(aoi, {color: 'red'}, 'Tarkwa-Nsuaem AOI', false);

// ==================== 1. Sentinel-5P CH₄ & CO ====================
var ch4 = ee.ImageCollection('COPERNICUS/S5P/OFFL/L3_CH4')
  .filterDate('2018-07-01', '2025-12-31')
  .filterBounds(aoi.geometry())
  .select('CH4_column_volume_mixing_ratio_dry_air');

var co = ee.ImageCollection('COPERNICUS/S5P/NRTI/L3_CO')
  .filterDate('2018-07-01', '2025-12-31')
  .filterBounds(aoi.geometry())
  .select('CO_column_number_density');

print('S5P CH₄ images (2018–2025):', ch4.size());
print('S5P CO images (2018–2025):', co.size());

// ==================== 2. Overall Means ====================
var ch4Mean = ch4.mean().clip(aoi);
var coMean  = co.mean().clip(aoi);

Map.addLayer(ch4Mean, {min:1800, max:1950, palette:['black','blue','cyan','green','yellow','red']}, 
             'CH₄ Mean 2018–2025 (ppbv)', false);
Map.addLayer(coMean,  {min:0.02, max:0.08, palette:['#000004','#3B1F6E','#8C50A4','#C4A3D3','#FFFFD4']}, 
             'CO Mean 2018–2025 (mol/m²)', true);

// Legends (same as before — omitted here for brevity, copy from previous script if you want them)

// Stats
var meanCH4 = ch4Mean.reduceRegion(ee.Reducer.mean(), aoi.geometry(), 7000).get('CH4_column_volume_mixing_ratio_dry_air');
var meanCO  = coMean.reduceRegion(ee.Reducer.mean(), aoi.geometry(), 7000).get('CO_column_number_density');
print('Mean CH₄ (ppbv):', ee.Number(meanCH4).format('%.1f'));
print('Mean CO (mol/m²):', ee.Number(meanCO).format('%.4f'));

// ==================== 3. MONTHLY MEANS – ROBUST VERSION ====================
var startYear = 2018;
var endYear   = 2025;
var years = ee.List.sequence(startYear, endYear);
var months = ee.List.sequence(1,12);

// Function to create monthly mean (returns null if no data)
function makeMonthly(collection, bandName, year, month) {
  var start = ee.Date.fromYMD(year, month, 1);
  var end   = start.advance(1, 'month');
  var img = collection.filterDate(start, end).mean();
  var count = collection.filterDate(start, end).size();
  return ee.Algorithms.If(
    count.gt(0),
    img.set('year', year).set('month', month).set('system:time_start', start.millis()),
    null
  );
}

// Build monthly CH₄
var monthlyCH4 = ee.ImageCollection.fromImages(
  years.map(function(y) {
    return months.map(function(m) {
      return makeMonthly(ch4, 'CH4_column_volume_mixing_ratio_dry_air', y, m);
    });
  }).flatten()
).filter(ee.Filter.notNull(['system:time_start']));

// Build monthly CO
var monthlyCO = ee.ImageCollection.fromImages(
  years.map(function(y) {
    return months.map(function(m) {
      return makeMonthly(co, 'CO_column_number_density', y, m);
    });
  }).flatten()
).filter(ee.Filter.notNull(['system:time_start']));

print('Valid monthly CH₄ images:', monthlyCH4.size());
print('Valid monthly CO images:',  monthlyCO.size());

// ==================== 4. Monthly Climatology & Anomalies ====================
var ch4Clim = ee.ImageCollection.fromImages(
  months.map(function(m) {
    var filtered = monthlyCH4.filter(ee.Filter.eq('month', m));
    return filtered.mean().set('month', m);
  })
);

var coClim = ee.ImageCollection.fromImages(
  months.map(function(m) {
    var filtered = monthlyCO.filter(ee.Filter.eq('month', m));
    return filtered.mean().set('month', m);
  })
);

// Anomalies
var ch4Anomalies = monthlyCH4.map(function(img) {
  var m = img.get('month');
  var clim = ch4Clim.filter(ee.Filter.eq('month', m)).first();
  return img.subtract(clim).rename('CH4_anomaly')
            .copyProperties(img, ['system:time_start','year','month']);
});

var coAnomalies = monthlyCO.map(function(img) {
  var m = img.get('month');
  var clim = coClim.filter(ee.Filter.eq('month', m)).first();
  return img.subtract(clim).rename('CO_anomaly')
            .copyProperties(img, ['system:time_start','year','month']);
});

// ==================== 5. CHARTS – NOW WORKING ====================
var chartCH4 = ui.Chart.image.series(monthlyCH4, aoi, ee.Reducer.mean(), 7000, 'system:time_start')
  .setOptions({title: 'Tarkwa-Nsuaem Monthly CH₄ (ppbv)', vAxis: {title: 'CH₄ (ppbv)'}, lineWidth: 2, pointSize: 4});
print(chartCH4);

var chartCH4Anom = ui.Chart.image.series(ch4Anomalies, aoi, ee.Reducer.mean(), 7000, 'system:time_start')
  .setOptions({title: 'CH₄ Monthly Anomalies (ppbv)', colors: ['#d73027'], lineWidth: 2});
print(chartCH4Anom);

var chartCO = ui.Chart.image.series(monthlyCO, aoi, ee.Reducer.mean(), 7000, 'system:time_start')
  .setOptions({title: 'Tarkwa-Nsuaem Monthly CO (mol/m²)', vAxis: {title: 'CO (mol/m²)'}, lineWidth: 2});
print(chartCO);

var chartCOAnom = ui.Chart.image.series(coAnomalies, aoi, ee.Reducer.mean(), 7000, 'system:time_start')
  .setOptions({title: 'CO Monthly Anomalies (mol/m²)', colors: ['#1a9850'], lineWidth: 2});
print(chartCOAnom);

// ==================== 6. EXPORTS ====================
Export.image.toDrive({image: ch4Mean.rename('CH4').addBands(coMean.rename('CO')).toFloat(),
  description: 'Tarkwa_Mean_CH4_CO_2018_2025', folder: 'GHG_Data', fileNamePrefix: 'Tarkwa_Mean', region: aoi.geometry(), scale: 7000, maxPixels: 1e10});

Export.image.toDrive({image: monthlyCH4.toBands().clip(aoi).toFloat(), description: 'Tarkwa_CH4_Monthly', folder: 'GHG_Data', fileNamePrefix: 'Tarkwa_CH4_monthly', region: aoi.geometry(), scale: 7000, maxPixels: 1e10});
Export.image.toDrive({image: monthlyCO.toBands().clip(aoi).toFloat(),  description: 'Tarkwa_CO_Monthly',  folder: 'GHG_Data', fileNamePrefix: 'Tarkwa_CO_monthly',  region: aoi.geometry(), scale: 7000, maxPixels: 1e10});
Export.image.toDrive({image: ch4Anomalies.toBands().clip(aoi).toFloat(), description: 'Tarkwa_CH4_Anomalies', folder: 'GHG_Data', fileNamePrefix: 'Tarkwa_CH4_anomalies', region: aoi.geometry(), scale: 7000, maxPixels: 1e10});
Export.image.toDrive({image: coAnomalies.toBands().clip(aoi).toFloat(),  description: 'Tarkwa_CO_Anomalies',  folder: 'GHG_Data', fileNamePrefix: 'Tarkwa_CO_anomalies',  region: aoi.geometry(), scale: 7000, maxPixels: 1e10});

print('All done – no more empty collection errors!');
print('Charts are now working. Monthly images with data:', monthlyCH4.size().getInfo(), 'CH₄ |', monthlyCO.size().getInfo(), 'CO');