// Generate non-mined/control sites dynamically
// Create a 2.5 km buffer around mined sites to avoid overlap
var minedBuffer = minedSites.map(function(f){ return f.buffer(2500); });
var nonMinedCandidates = aoi.filterBounds(aoi.geometry())
  .difference(minedBuffer.union(1));
var nonMinedSites = ee.FeatureCollection.randomPoints({
  region: nonMinedCandidates.geometry(),
  points: minedSites.size(),
  seed: 42
}).map(function(f){ return ee.Feature(f).set('class',0); });

