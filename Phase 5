var ch4 = ee.ImageCollection('COPERNICUS/S5P/OFFL/L3_CH4')
            .filterDate('2018-07-01','2025-12-31').filterBounds(aoi)
            .select('CH4_column_volume_mixing_ratio_dry_air');

var co = ee.ImageCollection('COPERNICUS/S5P/NRTI/L3_CO')
           .filterDate('2018-07-01','2025-12-31').filterBounds(aoi)
           .select('CO_column_number_density');

var ch4Mean = ch4.mean().clip(aoi);
var coMean = co.mean().clip(aoi);

Map.addLayer(ch4Mean, {min:1800, max:1950, palette:['black','blue','cyan','green','yellow','red']}, 'CH4 Mean 2018–2025');
Map.addLayer(coMean, {min:0.02, max:0.08, palette:['#000004','#3B1F6E','#8C50A4','#C4A3D3','#FFFFD4']}, 'CO Mean 2018–2025');

