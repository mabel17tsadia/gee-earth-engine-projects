// 3. MONTHLY ANOMALIES & CHARTS
///////////////////////////////

var startYear = 2018, endYear = 2025;
var yearsList = ee.List.sequence(startYear,endYear);
var months = ee.List.sequence(1,12);

function makeMonthly(collection, year, month){
  var start = ee.Date.fromYMD(year, month,1);
  var end = start.advance(1,'month');
  var img = collection.filterDate(start,end).mean();
  var count = collection.filterDate(start,end).size();
  return ee.Algorithms.If(count.gt(0), img.set('year',year).set('month',month).set('system:time_start', start.millis()), null);
}

var monthlyCH4 = ee.ImageCollection.fromImages(
  yearsList.map(function(y){ return months.map(function(m){ return makeMonthly(ch4,y,m); }); }).flatten()
).filter(ee.Filter.notNull(['system:time_start']));

var monthlyCO = ee.ImageCollection.fromImages(
  yearsList.map(function(y){ return months.map(function(m){ return makeMonthly(co,y,m); }); }).flatten()
).filter(ee.Filter.notNull(['system:time_start']));

var ch4Clim = ee.ImageCollection.fromImages(months.map(function(m){ return monthlyCH4.filter(ee.Filter.eq('month',m)).mean().set('month',m); }));
var coClim = ee.ImageCollection.fromImages(months.map(function(m){ return monthlyCO.filter(ee.Filter.eq('month',m)).mean().set('month',m); }));

var ch4Anomalies = monthlyCH4.map(function(img){ 
  var clim = ch4Clim.filter(ee.Filter.eq('month', img.get('month'))).first();
  return img.subtract(clim).rename('CH4_anomaly').copyProperties(img,['system:time_start','year','month']); 
});

var coAnomalies = monthlyCO.map(function(img){ 
  var clim = coClim.filter(ee.Filter.eq('month', img.get('month'))).first();
  return img.subtract(clim).rename('CO_anomaly').copyProperties(img,['system:time_start','year','month']); 
});

// Charts
print(ui.Chart.image.series(monthlyCH4, aoi, ee.Reducer.mean(), 7000, 'system:time_start').setOptions({title:'Monthly CH₄ (ppbv)', vAxis:{title:'CH₄'}, lineWidth:2, pointSize:4}));
print(ui.Chart.image.series(ch4Anomalies, aoi, ee.Reducer.mean(), 7000, 'system:time_start').setOptions({title:'Monthly CH₄ Anomalies', colors:['#d73027'], lineWidth:2}));
print(ui.Chart.image.series(monthlyCO, aoi, ee.Reducer.mean(), 7000, 'system:time_start').setOptions({title:'Monthly CO (mol/m²)', vAxis:{title:'CO'}, lineWidth:2}));
print(ui.Chart.image.series(coAnomalies, aoi, ee.Reducer.mean(), 7000, 'system:time_start').setOptions({title:'Monthly CO Anomalies', colors:['#1a9850'], lineWidth:2}));

///////////////////////////////
// 4. CO ANOMALY vs CUMULATIVE MINED AREA (Scatter)
///////////////////////////////

var miningSitesWithYear = minedSites.map(function(f){ return f.set('year_first_active', ee.Algorithms.If(f.get('year'), f.get('year'), 2018)); });

var mineBuffers = miningSitesWithYear.map(function(f){ return f.buffer(2500).intersection(aoi.geometry()); });
var minedAreaFC = ee.FeatureCollection(yearsList.map(function(y){
  var active = miningSitesWithYear.filter(ee.Filter.lte('year_first_active', y));
  var buffers = active.map(function(f){ return f.geometry().buffer(2500).intersection(aoi.geometry()); });
  var union = ee.FeatureCollection(buffers).union(1);
  var areaHa = union.geometry().area().divide(10000);
  return ee.Feature(null, {year:y, mined_area_ha:areaHa});
}));

// Annual CO anomaly
var anomaliesMonthly = monthlyCO.map(function(img){
  var c = coClim.filter(ee.Filter.eq('month', img.get('month'))).first();
  return img.subtract(c).rename('CO_anomaly').set('year', img.get('year'));
});

var annualCO = ee.FeatureCollection(yearsList.map(function(y){
  var img = anomaliesMonthly.filter(ee.Filter.eq('year', y)).mean();
  var val = img.reduceRegions({collection: mineBuffers, reducer: ee.Reducer.mean(), scale:10000}).aggregate_mean('CO_anomaly');
  return ee.Feature(null, {year:y, CO_anomaly: ee.Number(ee.Algorithms.If(val,val,0))});
}));

var finalTable = minedAreaFC.map(function(f){
  var y = f.get('year');
  var coF = annualCO.filter(ee.Filter.eq('year',y)).first();
  var coVal = ee.Number(ee.Algorithms.If(coF, coF.get('CO_anomaly'),0));
  return f.set('CO_anomaly', coVal);
}));

// Scatter plot
var data = finalTable.toList(10).getInfo();
var chart = ui.Chart.array.values({
  array: data.map(function(d){ return d.properties.CO_anomaly; }),
  axis: 0,
  xLabels: data.map(function(d){ return d.properties.mined_area_ha; })
}).setChartType('ScatterChart')
.setOptions({
  title:'CO Anomaly vs Cumulative Mined Area – Prestea Huni Valley',
  hAxis:{title:'Cumulative Mined Area (ha)'},
  vAxis:{title:'Annual Mean CO Anomaly (mol/m²)'},
  pointSize:16,
  colors:['#d7191c'],
  trendlines:{0:{showR2:true, visibleInLegend:true, color:'red', lineWidth:6, opacity:0.9}},
  legend:{position:'none'}
});
print(chart);

// Pearson r and R²
var x = data.map(function(d){ return d.properties.mined_area_ha; });
var y = data.map(function(d){ return d.properties.CO_anomaly; });
var n = x.length;
var sumX = x.reduce(function(a,b){return a+b;},0);
var sumY = y.reduce(function(a,b){return a+b;},0);
var sumXY = x.map(function(v,i){return v*y[i];}).reduce(function(a,b){return a+b;},0);
var sumX2 = x.map(function(v){return v*v;}).reduce(function(a,b){return a+b;},0);
var sumY2 = y.map(function(v){return v*v;}).reduce(function(a,b){return a+b;},0);
var r = (n*sumXY - sumX*sumY)/Math.sqrt((n*sumX2 - sumX*sumX)*(n*sumY2 - sumY*sumY));
print('Pearson r =', Number(r).toFixed(4));
print('R² =', Number(r*r).toFixed(4));

// Exports
Export.image.toDrive({image: VLI.addBands(WEI).toFloat(), description:'PresteaHuni_VLI_WEI_2025', folder:'Galamsey_Impact', fileNamePrefix:'PresteaHuni_VLI_WEI_2025', region:aoi.geometry(), scale:30, crs:'EPSG:32630', maxPixels:1e13});
Export.image.toDrive({image: ch4Mean.rename('CH4').addBands(coMean.rename('CO')).toFloat(), description:'PresteaHuni_S5P_CH4_CO_2018_2025', folder:'GHG_Data', fileNamePrefix:'PresteaHuni_S5P_CH4_CO_2018_2025', region:aoi.geometry(), scale:7000, maxPixels:1e10});
Export.table.toDrive({collection:finalTable, folder:'GHG_Data', description:'PresteaHuni_CO_vs_MinedArea', fileFormat:'CSV'});

