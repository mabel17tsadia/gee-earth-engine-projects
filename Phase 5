///////////////////////////////
// 1. VEGETATION LOSS & WATER EXPANSION (2010–2025)
///////////////////////////////

function harmonize(img, redBand, nirBand){
  return img.select([redBand, nirBand])
            .multiply(0.0000275).add(-0.2)
            .rename(['Red','NIR'])
            .copyProperties(img, ['system:time_start']);
}

function maskClouds(img){
  var qa = img.select('QA_PIXEL');
  var clear = qa.bitwiseAnd(8).eq(0)
               .and(qa.bitwiseAnd(16).eq(0))
               .and(qa.bitwiseAnd(4).eq(0));
  return img.updateMask(clear);
}

var years = ee.List.sequence(2010, 2025);

var annual = ee.ImageCollection.fromImages(
  years.map(function(y){
    var start = ee.Date.fromYMD(y,1,1);
    var end = start.advance(1,'year');
    var l5 = ee.ImageCollection('LANDSAT/LT05/C02/T1_L2')
               .filterDate(start,end).filterBounds(aoi)
               .map(function(i){return harmonize(i,'SR_B3','SR_B4');});
    var l7 = ee.ImageCollection('LANDSAT/LE07/C02/T1_L2')
               .filterDate(start,end).filterBounds(aoi)
               .map(function(i){return harmonize(i,'SR_B3','SR_B4');});
    var l8l9 = ee.ImageCollection('LANDSAT/LC08/C02/T1_L2')
                  .merge(ee.ImageCollection('LANDSAT/LC09/C02/T1_L2'))
                  .filterDate(start,end).filterBounds(aoi)
                  .map(maskClouds)
                  .map(function(i){return harmonize(i,'SR_B4','SR_B5');});
    var coll = l5.merge(l7).merge(l8l9).median().clip(aoi);
    return coll
      .addBands(coll.normalizedDifference(['NIR','Red']).rename('NDVI'))
      .addBands(coll.expression('NIR - Red', {NIR: coll.select('NIR'), Red: coll.select('Red')}).rename('NDWI_Gao'))
      .set('year',y);
  })
);

var img2010 = annual.filter(ee.Filter.eq('year',2010)).first();
var img2025 = annual.filter(ee.Filter.eq('year',2025)).first();

// Delta Images
var deltaNDVI = img2010.select('NDVI').subtract(img2025.select('NDVI')).rename('dNDVI');
var deltaNDWI = img2025.select('NDWI_Gao').subtract(img2010.select('NDWI_Gao')).rename('dNDWI');

// Training points
var points = minedSites.map(function(f){return f.set('class',1);})
                       .merge(nonMinedSites);

var training = deltaNDVI.addBands(deltaNDWI)
              .sampleRegions({collection: points, properties:['class'], scale:30});

// Extract thresholds
function getThreshold(classifier){
  var treeString = ee.String(classifier.explain().get('tree'));
  var match = treeString.match('[-+]?[0-9]*\\.?[0-9]+([eE][-+]?[0-9]+)?');
  return ee.Number.parse(ee.List(match).get(0));
}

var cartNDVI = ee.Classifier.smileCart().train({features: training, classProperty:'class', inputProperties:['dNDVI']});
var cartNDWI = ee.Classifier.smileCart().train({features: training, classProperty:'class', inputProperties:['dNDWI']});

var threshNDVI = getThreshold(cartNDVI);
var threshNDWI = getThreshold(cartNDWI);

// Final Indices
var VLI = deltaNDVI.clip(aoi).rename('Vegetation_Loss_Index');
var WEI = deltaNDWI.clip(aoi).rename('Water_Expansion_Index');

var severeLoss = VLI.gte(threshNDVI);
var newWater = WEI.gte(threshNDWI).and(img2025.select('NDWI_Gao').gt(0.05));

// Map Layers – ONLY 1 layer each
Map.addLayer(VLI.selfMask(), {min:0, max:0.7, palette:['white','#ffffb2','#fecc5c','#fd8d3c','#f03b20','#bd0026']}, 'Vegetation Loss Index 2025');
Map.addLayer(WEI.selfMask(), {min:0, max:0.5, palette:['white','#deebf7','#9ecae1','#4292c6','#2171b5','#084594']}, 'Water Expansion Index 2025');
Map.addLayer(minedSites, {color:'red'}, 'Mined Sites');
Map.addLayer(nonMinedSites, {color:'lime'}, 'Non-Mined Sites');

